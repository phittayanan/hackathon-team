{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node scripts/agent-sync.js --auto",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/voice/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/pics/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
