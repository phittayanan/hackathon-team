# Copy this file to .env and put real keys there. .env is never committed.

# Optional. Agent voice via ElevenLabs TTS (model eleven_v4). Pick a voice that speaks Thai well.
# Without it, the app plays the pre-rendered MP3s in web/public/voice/, then the browser's own voice.
ELEVENLABS_API_KEY=
# Optional voice id; the default is the premade voice "Jessica".
ELEVENLABS_VOICE_ID=

# Optional. The live agent brain (ElevenLabs agent with Thai voice and speech to text).
# `cd web && npm run agent:sync` creates it and writes these two lines. The key needs the
# Agents permission (scope convai_write). Pictures in generated pages need the
# Image & Video permission and a Pro plan. Without them the app uses its offline keyword brain.
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_IDS=
# Written by agent:sync too: hash:id of the agent's fact sheet (web/agent/knowledge.md) in the
# ElevenLabs knowledge base. A test agent of your own: npm run agent:sync -- --env ../.env.test-agent
ELEVENLABS_KNOWLEDGE=

# Optional. Real web search for the live agent (Tavily, free tier, basic search = 1 credit).
# Server side only. Without it the agent has no web_search tool and nothing else changes.
# After adding it, run `cd web && npm run agent:sync` so the agent gets the tool.
TAVILY_API_KEY=

# Optional. Page model for generated pages (Google Gemini API). Server side only. Without it the
# block page stays. The live agent needs one `npm run agent:sync` to start sending design briefs.
GEMINI_API_KEY=

# Optional. Daily usage limit, checked before every call that spends ElevenLabs or Tavily credit.
# Live sessions and other calls (voice, search), for the whole site and per visitor, per UTC day.
# Empty = the defaults in web/lib/usage.js (200 / 12 sessions, 1500 / 120 calls). When a limit is
# reached, or the ElevenLabs credit runs out, the page switches to its offline mode by itself.
USAGE_SESSIONS_PER_DAY=
USAGE_SESSIONS_PER_VISITOR=
USAGE_CALLS_PER_DAY=
USAGE_CALLS_PER_VISITOR=

# Optional. Where the limit counts are kept. Vercel functions keep no memory between calls, so on
# Vercel add a free Upstash Redis database (Vercel Marketplace sets KV_REST_API_URL and
# KV_REST_API_TOKEN; either pair works). Without one the count lives in memory: exact locally,
# best effort on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
