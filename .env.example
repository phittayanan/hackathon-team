# Copy this file to .env and put real keys there. .env is never committed.

# Optional. Agent voice via ElevenLabs TTS (model eleven_v4). Pick a voice that speaks Thai well.
# Without it, the app plays the pre-rendered MP3s in web/public/voice/, then the browser's own voice.
ELEVENLABS_API_KEY=
# Optional voice id; the default is the premade voice "Jessica".
ELEVENLABS_VOICE_ID=

# Optional. The live agent brain (ElevenLabs agent with Thai voice and speech to text).
# `cd web && npm run agent:sync` creates or updates it (with its tools and its fact sheet,
# web/agent/knowledge.md) in every account, and the text-only page writer agent that writes
# generated pages (each page spends credit); the server finds both by name, so no ids are needed.
# The key needs the Agents permission (scope convai_write). Without a key the app uses its
# offline keyword brain. Pictures in generated pages are made ahead of time and need no key.
# ELEVENLABS_AGENT_ID pins one agent (a test agent of your own: see README), single key only.
ELEVENLABS_AGENT_ID=

# Optional. Several ElevenLabs accounts (each teammate's own key), comma separated, used in order:
# one out of credit is skipped for the rest of the UTC day. Replaces ELEVENLABS_API_KEY. No agent
# ids needed: each account's agent is found by name, and every production deploy on Vercel
# creates or updates it (agent-sync --auto). Adding a teammate = add the key here and redeploy.
ELEVENLABS_API_KEYS=

# Optional. Daily usage limit, checked before every provider call.
# Optional. YouTube Data API v3 key (Google Cloud console, API restricted to YouTube Data API v3).
# With it the video screen lists clips and plays them in the app; without it, only a link to YouTube.
YOUTUBE_API_KEY=

# Live sessions and other calls (voice, search), for the whole site and per visitor, per UTC day.
# Empty = the defaults in web/lib/usage.js (200 / 12 sessions, 1500 / 120 calls). When a limit is
# reached, or the ElevenLabs credit runs out, the page switches to its offline mode by itself.
USAGE_SESSIONS_PER_DAY=
USAGE_SESSIONS_PER_VISITOR=
USAGE_CALLS_PER_DAY=
USAGE_CALLS_PER_VISITOR=

# Optional. Where the limit counts are kept. Vercel functions keep no memory between calls, so on
# Vercel add a free Upstash Redis database (Vercel Marketplace sets KV_REST_API_URL and
# KV_REST_API_TOKEN; either pair works). Without one the count lives in memory: exact locally,
# best effort on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
